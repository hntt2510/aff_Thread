# Shopee Session Worker Environment Variables
# Copy to .env for local operation. DO NOT commit .env to git.

# Secret for authenticating worker requests with Main Application
# MUST match SHOPEE_WORKER_SECRET in Main App / Vercel
SHOPEE_WORKER_SECRET=your_32_character_shopee_worker_secret_here

# Main Application URL (local development or production Vercel)
# Local: http://localhost:3000
# Production: https://affthread-chi.vercel.app
SHOPEE_MAIN_APP_URL=http://localhost:3000

# Dry-run flag (true: acquires, validates, previews, but NEVER posts to Main App)
SHOPEE_WORKER_DRY_RUN=false

# Local Persistent Dedicated Chrome Profile Directory (relative to worker root)
SHOPEE_CHROME_PROFILE_DIR=.local/shopee-chrome-profile

# Optional explicit Google Chrome executable path (auto-discovered if omitted)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Candidate count settings
SHOPEE_TARGET_CANDIDATES=60
SHOPEE_MAX_CANDIDATES=100

# Application Environment Variables
# Copy to .env.local for local development. DO NOT commit real secrets to git.

# Admin Authentication
ADMIN_USERNAME=admin
# Generate using: node -e "const crypto=require('crypto'); const salt=crypto.randomBytes(16).toString('hex'); const hash=crypto.scryptSync('your_password', salt, 64).toString('hex'); console.log(\`\${salt}:\${hash}\`)"
ADMIN_PASSWORD_HASH=your_scrypt_salt_and_hash_here

# 24-Hour Session Signing Secret (minimum 32 characters)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_32_character_or_longer_session_secret_here

# Threads Access Token Encryption Key (32 bytes / 64 hex characters for AES-256-GCM)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
THREADS_TOKEN_ENCRYPTION_KEY=your_64_hex_character_encryption_key_here

# PostgreSQL Database Connection URL (supports local postgres, Neon, Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/aff_thread

# Scheduler & Background Queue Authorization Secret (recommended 32+ characters)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_32_character_or_longer_cron_secret_here

# Shopee Session Worker Ingestion Authorization Secret (recommended 32+ characters)
# Must match SHOPEE_WORKER_SECRET on the external worker machine
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHOPEE_WORKER_SECRET=your_32_character_or_longer_shopee_worker_secret_here

# TikW-API (tikwmapi.com) Official Developer API Key for Viral Video Discovery
TIKW_API_KEY=your_tikw_api_key_here
